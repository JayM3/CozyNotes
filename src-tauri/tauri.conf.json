{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CozyNotes",
  "version": "0.2.8",
  "identifier": "com.cozynotes.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "library",
        "title": "CozyNotes",
        "decorations": false,
        "width": 615,
        "height": 500,
        "minWidth": 480,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "homepage": "https://github.com/JayM3/CozyNotes"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBDMjlCQzk1QzAyNTc2N0MKUldSOGRpWEFsYndwRE5xbG5Jdk55ZEFNenE4V3JmWUlwTW01U3N1ZkdLbEJDWkFBalFiMDBweXAK",
      "endpoints": ["https://github.com/JayM3/CozyNotes/releases/latest/download/latest.json"]
    }
  }
}
